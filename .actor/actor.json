{
  "actorSpecification": 1,
  "name": "pdf-ocr-extractor",
  "title": "OCR PDF Extractor: Image to Text, PDF to Markdown & Tables",
  "description": "Extract text and tables from PDFs and images: PDF to text or Markdown, image to text OCR for scans (Tesseract), 13 languages including Hebrew and Arabic (RTL). Uses the PDF text layer when present, so you pay OCR prices only for scanned pages.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Files",
          "transformation": {
            "fields": [
              "url",
              "pageCount",
              "ocrPages",
              "textLayerPages",
              "tableCount",
              "content",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "File",
                "format": "link"
              },
              "pageCount": {
                "label": "Pages",
                "format": "number"
              },
              "ocrPages": {
                "label": "OCR pages",
                "format": "number"
              },
              "textLayerPages": {
                "label": "Text-layer pages",
                "format": "number"
              },
              "tableCount": {
                "label": "Tables",
                "format": "number"
              },
              "content": {
                "label": "Content"
              },
              "error": {
                "label": "Error"
              }
            }
          }
        }
      }
    }
  }
}
